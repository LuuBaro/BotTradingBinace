# Frontend API Configuration
# ==========================

# IMPORTANT: Set this for production deployments
# Specifies the backend API base URL that the dashboard will connect to
# Examples:
#   VITE_API_BASE_URL=http://localhost:8000/api/          (Local development)
#   VITE_API_BASE_URL=https://api.yourdomain.com/api/      (Production)
#   VITE_API_BASE_URL=https://api.staging.com/api/         (Staging)
VITE_API_BASE_URL=http://localhost:8000/api/

# Google OAuth Configuration (optional)
# Get from: https://console.cloud.google.com/
# Required for /login via Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Environment
# Set to 'production' or 'development'
VITE_ENV=development

# Debug Mode (optional)
# Set to 'true' to enable verbose logging
VITE_DEBUG=false
