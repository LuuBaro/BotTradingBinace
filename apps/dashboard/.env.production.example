# Frontend API Configuration - PRODUCTION
# =========================================

# REQUIRED: Set this to your production API domain
# This is where the dashboard will send API requests
# IMPORTANT: Must be set - there is NO fallback to localhost in production
VITE_API_BASE_URL=https://api.yourdomain.com/api/

# Google OAuth Configuration (REQUIRED for OAuth login)
# Get from: https://console.cloud.google.com/
# Create a new Web application OAuth credential
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Environment - Set to 'production'
VITE_ENV=production

# Debug Mode - Set to 'false' in production
VITE_DEBUG=false
