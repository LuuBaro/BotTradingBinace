# Bot Trading Platform - Environment Configuration Template
# COPY TO .env (local dev) or .env.production (deployment)
# ⚠️ NEVER COMMIT THIS FILE WITH REAL VALUES! Add actual values only locally.
# Keep this template clean for git commits.

# ============================================================================
# ENVIRONMENT MODE
# ============================================================================
# Set to either: demo, live
# demo = testing/development mode
# live = production with real trading (use with caution!)
ENV=demo

# ============================================================================
# DATABASE
# ============================================================================
DB_URL=sqlite+aiosqlite:///./data/trading.db

# ============================================================================
# API SERVER
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8001

# ============================================================================
# BINANCE EXCHANGE API
# ============================================================================
# Get from: https://www.binance.com/en/user/settings/api-management
# ⚠️ Testnet keys: https://testnet.binance.vision/
# ⚠️ Live keys: KEEP THESE VERY SECURE! Use IP whitelist on Binance!

BINANCE_TESTNET=true
BINANCE_API_KEY=<your_binance_api_key_here>
BINANCE_API_SECRET=<your_binance_api_secret_here>

# Manual timestamp offset (milliseconds) if system clock drifts
# Default: 0 (no offset)
# Fix large offsets: w32tm /resync (Windows) or sudo ntpdate -u pool.ntp.org (Linux)
BINANCE_TIMESTAMP_OFFSET=0

# ============================================================================
# LLM PROVIDERS - AI Decision Making
# ============================================================================
# Selected provider: mock, openai, groq, anthropic, gemini
SELECTED_LLM=mock

# OpenAI (GPT-4)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=<your_openai_api_key_here>
OPENAI_MODEL=gpt-4o-mini

# Groq (Llama - Fast & Cheap)
# Get from: https://console.groq.com/
GROQ_API_KEY=<your_groq_api_key_here>
GROQ_MODEL=llama-3.1-8b-instant

# Anthropic (Claude)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=<your_anthropic_api_key_here>
ANTHROPIC_MODEL=claude-3-sonnet

# Google Gemini
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=<your_gemini_api_key_here>
GEMINI_MODEL=gemini-1.5-pro

# ============================================================================
# WORKER AI - Optimization & Rate Limiting
# ============================================================================
WORKER_AI_MAX_SYMBOLS_PER_LOOP=2
WORKER_AI_MIN_INTERVAL_MS=350
WORKER_AI_BACKOFF_BASE_SEC=2.0
WORKER_AI_BACKOFF_MAX_SEC=60.0
WORKER_AI_PRIORITIZE_OPEN_POSITIONS=true

# 2-Tier Cascade (Scout → Verifier) to reduce token usage
WORKER_AI_USE_TWO_TIER=false
WORKER_AI_SCOUT_PROVIDER=groq
WORKER_AI_SCOUT_MODEL=llama-3.1-8b-instant
WORKER_AI_VERIFIER_PROVIDER=openai
WORKER_AI_VERIFIER_MODEL=gpt-4
WORKER_AI_SCOUT_CONFIDENCE_THRESHOLD=0.6

# AI Mode & Prompt Level
# Mode: two_tier_hybrid, two_tier_same, single_tier
# Level: lightweight, standard, heavyweight
WORKER_AI_MODE=two_tier_hybrid
WORKER_AI_PROMPT_LEVEL=standard

# ============================================================================
# TELEGRAM BOT - Alerts & Notifications
# ============================================================================
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=<your_telegram_bot_token_here>
TELEGRAM_ADMIN_IDS=<your_telegram_admin_chat_id>
TELEGRAM_TRADER_IDS=<comma_separated_trader_ids>

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# SECURITY - JWT Authentication
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be at least 32 characters for security
JWT_SECRET=<generate_secure_random_string_32_chars_minimum>

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_LEARNING_AGENT=true
ENABLE_AUTO_ADAPT=false

# ============================================================================
# OPTIONAL: Local LLM Support
# ============================================================================
USE_LOCAL_LLM=false
CUSTOM_PROVIDER_NAME=
CUSTOM_PROVIDER_URL=
CUSTOM_PROVIDER_KEY=
CUSTOM_PROVIDER_MODEL=

# ============================================================================
# OPTIONAL: Google OAuth (Dashboard Login)
# ============================================================================
GOOGLE_CLIENT_ID=