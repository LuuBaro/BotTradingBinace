# Bot Trading Platform - Environment Configuration
# Copy to .env.production and fill in actual values for production deployment

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================================================
# DATABASE - PostgreSQL (Production)
# ============================================================================
DB_USER=bottrading
DB_PASSWORD=changeme_set_strong_password_here
DB_HOST=db
DB_PORT=5432
DB_NAME=bottrading

# ============================================================================
# REDIS - Cache & Job Queue
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_set_strong_password_here

# ============================================================================
# API SERVER
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://yourdomain.com

# ============================================================================
# SECURITY - JWT & Authentication
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=changeme_set_long_random_string_here_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# LLM CONFIGURATION (Phase 5)
# ============================================================================
SELECTED_LLM=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-sonnet

# ============================================================================
# WORKER AI OPTIMIZATION - Rate Limit & Token Management
# ============================================================================
# Anti-429 Rate Limit Protection
WORKER_AI_MAX_SYMBOLS_PER_LOOP=2
WORKER_AI_MIN_INTERVAL_MS=350
WORKER_AI_BACKOFF_BASE_SEC=2.0
WORKER_AI_BACKOFF_MAX_SEC=60.0
WORKER_AI_PRIORITIZE_OPEN_POSITIONS=true

# 2-Tier Cascade Mode (Scout → Verifier)
# Enable to reduce token usage: lightweight scout scans many symbols,
# expensive verifier only analyzes high-priority signals
WORKER_AI_USE_TWO_TIER=false
WORKER_AI_SCOUT_PROVIDER=groq
WORKER_AI_SCOUT_MODEL=llama-3.1-8b-instant
WORKER_AI_VERIFIER_PROVIDER=openai
WORKER_AI_VERIFIER_MODEL=gpt-4-turbo
WORKER_AI_SCOUT_CONFIDENCE_THRESHOLD=0.6

# ============================================================================
# BACKUP & RECOVERY
# ============================================================================
BACKUP_DIR=/app/backups
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
ENABLE_MONITORING=true
ENABLE_SLOWLOG=true
SLOW_QUERY_THRESHOLD_MS=1000

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_LEARNING_AGENT=true
ENABLE_AUTO_ADAPT=false